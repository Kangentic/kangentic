{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/bash-guard.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(touch:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(test:*)",
      "Bash(tasklist:*)",
      "Bash(grep:*)",
      "Bash(du:*)",
      "Bash(sqlite3:*)",
      "Bash(./node_modules/.bin/tsc --noEmit)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)",
      "Bash(reg query:*)",
      "Bash(fsutil reparsepoint query:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(start:*)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(Remove-Item *)",
      "mcp__context7",
      "mcp__kangentic",
      "WebSearch",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:vitejs.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:www.electronjs.org)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.npmjs.org)",
      "WebFetch(domain:www.kangentic.com)",
      "WebFetch(domain:kangentic.com)",
      "Skill"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true
}
