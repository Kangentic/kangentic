{
  "version": 1,
  "columns": [
    {
      "id": "e6350e8a-77fa-43a2-815b-6447820adf40",
      "name": "To Do",
      "role": "todo",
      "icon": "layers",
      "color": "#6b7280"
    },
    {
      "id": "4873bb89-9291-4f05-a2f7-e93f2dcc0c26",
      "name": "Planning",
      "icon": "map",
      "color": "#8b5cf6",
      "autoSpawn": true,
      "permissionMode": "plan",
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "planExitTarget": "Executing"
    },
    {
      "id": "dc9f2b38-5882-4182-8f09-923f2a583b08",
      "name": "Executing",
      "icon": "square-terminal",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "automations": {
        "onTurnEnd": [
          {
            "name": "On to Code Review",
            "type": "move_to_column",
            "condition": "The last line of the final message is exactly \"Findings: applied\".",
            "maxRuns": 4,
            "targetColumn": "Code Review"
          },
          {
            "name": "Apply findings",
            "type": "send_message",
            "message": "Check your last message for findings, recommendations or follow-up changes you have not applied yet, and apply them here in this task, not as follow-up tasks. Where one needs a decision, take your recommended option and name the alternative. If there are none, say so. Either way, end your turn with a short summary and the line \"Findings: applied\"."
          }
        ]
      }
    },
    {
      "id": "623a36ef-9045-4437-b9c8-f67312dc5437",
      "name": "Code Review",
      "icon": "code",
      "color": "#f59e0b",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "sessionTarget": "isolated",
      "sessionSpawnStrategy": "always_spawn_new",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/code-review {{baseBranch}}",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Back for revisions",
            "type": "move_to_column",
            "condition": "The final message's verdict line reads \"Verdict: Blocked\".",
            "maxRuns": 3,
            "targetColumn": "Executing",
            "message": "Code Review sent this back. Do the numbered steps under its verdict, commit, then end your turn.\n\n{{agentReply}}"
          },
          {
            "name": "On to Testing",
            "type": "move_to_column",
            "condition": "The final message's verdict line reads \"Verdict: Ready\".",
            "maxRuns": 1,
            "targetColumn": "Testing"
          }
        ]
      }
    },
    {
      "id": "1da886f1-804b-42ea-960e-2109f776d451",
      "name": "Testing",
      "icon": "flask-conical",
      "color": "#06b6d4",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "On to Merge",
            "type": "move_to_column",
            "condition": "The final message has a line that reads exactly \"PR: ready to merge\", and no line that reads \"PR: blocked\".",
            "maxRuns": 1,
            "targetColumn": "Merge"
          }
        ]
      }
    },
    {
      "id": "8adfe5cc-955c-4c4f-83a2-461e2a9d3c14",
      "name": "Merge",
      "icon": "merge",
      "color": "#f97316",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/merge-pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Finish",
            "type": "move_to_column",
            "condition": "The pull request is merged.",
            "maxRuns": 1,
            "targetColumn": "Done"
          }
        ]
      }
    },
    {
      "id": "64f9ef9a-c05d-44f8-a846-329a8f15e69f",
      "name": "Done",
      "role": "done",
      "icon": "circle-check-big",
      "color": "#10b981"
    }
  ],
  "_modifiedBy": "7ef4fd0cb484"
}
