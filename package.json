{
  "name": "kangentic",
  "productName": "Kangentic",
  "version": "0.31.0",
  "description": "Cross-platform desktop Kanban for Claude Code agents",
  "main": ".vite/build/index.js",
  "repository": "https://github.com/Kangentic/kangentic",
  "private": true,
  "workspaces": [
    "packages/launcher",
    "packages/protocol"
  ],
  "scripts": {
    "start": "node scripts/dev.js",
    "package": "npm run rebuild && npm run build && electron-builder --dir",
    "make": "npm run rebuild && npm run build && electron-builder",
    "make:win": "npm run rebuild && npm run build && electron-builder --win",
    "make:mac": "npm run rebuild && npm run build && electron-builder --mac",
    "make:linux": "npm run rebuild && npm run build && electron-builder --linux",
    "publish": "npm run rebuild && npm run build && electron-builder --publish always",
    "postinstall": "node scripts/rebuild-native.js",
    "rebuild": "node scripts/rebuild-native.js",
    "lint": "eslint src/ packages/protocol/src/ --max-warnings 0",
    "test": "npx playwright test --project=ui --project=electron",
    "test:headed": "HEADED=1 npx playwright test --project=ui --project=electron",
    "capture": "npx playwright test --project=captures",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "validate:kimi-mcp": "node scripts/kimi-validate-mcp.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "kangentic",
    "kanban",
    "claude",
    "claude-code",
    "agent",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Kangentic",
    "email": "hello@kangentic.com",
    "url": "https://github.com/Kangentic"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/fuses": "^2.1.1",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.4",
    "@kangentic/branding": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/remove-markdown": "^0.3.4",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^15.0.0",
    "electron": "41.1.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.17.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "uuid": "^14.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "which": "^7.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@huggingface/transformers": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@xterm/headless": "6.0.0",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "font-list": "^2.1.0",
    "monaco-editor": "^0.55.1",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.1.0",
    "p-queue": "^9.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.9.2",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.4",
    "sherpa-onnx-node": "^1.13.3",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
