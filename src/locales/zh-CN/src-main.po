#: src/main/notifications/desktop-notifier.ts
msgid "{place}. Stalled: {reason}"
msgstr "{place}。已停滞：{reason}"

#: src/main/notifications/desktop-notifier.ts
msgid "{place}. Waiting on you: {reason}"
msgstr "{place}。等待你处理：{reason}"

#: src/main/notifications/desktop-notifier.ts
msgid "{projectName}: {workflowName}"
msgstr "{projectName}：{workflowName}"

#: src/main/index.ts
msgid "{provider} blocks sign-in from apps that embed a browser, which is the usual cause here. You can open the sign-in page in your default browser, but signing in there does not sign you in inside this pane. To use the pane itself, sign in with a different method on that site."
msgstr "{provider} 会阻止内嵌浏览器的应用进行登录，这通常就是此处的原因。你可以在默认浏览器中打开登录页，但在那里登录并不会让此窗格也进入登录状态。若要使用此窗格本身，请在该网站上改用其他方式登录。"

#: src/main/index.ts
msgid "{provider} returned a sign-in error"
msgstr "{provider} 返回登录错误"

#: src/main/index.ts
msgid "{provider} would not complete this sign-in."
msgstr "{provider} 未能完成此次登录。"

