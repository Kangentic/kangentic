{
  "_README": "Sample OpenCode plugin invocation payloads. Shapes are derived from the official plugin docs (https://opencode.ai/docs/plugins/, April 2026) and the cmux reference plugin (https://gist.github.com/johnlindquist/0adf1032b4e84942f3e1050aba3c5e4a). Replace this fixture with a sanitized capture from a real OpenCode session once the spike documented in plans/opencode-hook-based-activity-stream-zazzy-tulip.md is run. The opencode-plugin.test.ts suite asserts our extractor functions against these inputs; if OpenCode's real shape diverges, update this file and the failing test will pin the new contract.",
  "event_session_created": {
    "type": "session.created",
    "properties": {
      "info": {
        "id": "ses_2349b5c91ffeKd6qajuUTR4clq",
        "title": "Refactor login flow"
      },
      "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq"
    }
  },
  "event_session_idle": {
    "type": "session.idle",
    "properties": {
      "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq"
    }
  },
  "event_session_error": {
    "type": "session.error",
    "properties": {
      "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq",
      "error": {
        "name": "RateLimitError",
        "message": "Anthropic API limit"
      }
    }
  },
  "event_session_unknown": {
    "type": "session.updated",
    "properties": {}
  },
  "_README_waits": "The question and permission events below follow OpenCode 1.18.31's own schema (packages/schema/src/v1/question.ts and v1/permission.ts): question.asked and permission.asked carry the request, the replies its id. The plugin `event` hook receives them for its directory with no type filter (packages/opencode/src/plugin/index.ts).",
  "event_question_asked": {
    "type": "question.asked",
    "properties": {
      "id": "que_01JQ7Z3V5K0000000000000000",
      "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq",
      "questions": [{ "question": "Which layout should the settings page use?", "header": "Layout", "options": [{ "label": "Tabs", "description": "One tab per area" }, { "label": "Single page", "description": "Every section on one scroll" }] }],
      "tool": { "messageID": "msg_01JQ7Z3V5K0000000000000001", "callID": "call_question_1" }
    }
  },
  "event_question_replied": {
    "type": "question.replied",
    "properties": { "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq", "requestID": "que_01JQ7Z3V5K0000000000000000", "answers": [["Tabs"]] }
  },
  "event_question_rejected": {
    "type": "question.rejected",
    "properties": { "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq", "requestID": "que_01JQ7Z3V5K0000000000000000" }
  },
  "event_permission_asked": {
    "type": "permission.asked",
    "properties": {
      "id": "per_01JQ7Z3V5K0000000000000002",
      "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq",
      "permission": "bash",
      "patterns": ["npm test"],
      "metadata": {},
      "always": ["npm test"],
      "tool": { "messageID": "msg_01JQ7Z3V5K0000000000000003", "callID": "call_bash_1" }
    }
  },
  "event_permission_replied": {
    "type": "permission.replied",
    "properties": { "sessionID": "ses_2349b5c91ffeKd6qajuUTR4clq", "requestID": "per_01JQ7Z3V5K0000000000000002", "reply": "once" }
  },
  "tool_before_bash": {
    "input": { "tool": "bash" },
    "output": {
      "args": {
        "command": "ls -la /tmp"
      }
    }
  },
  "tool_before_read": {
    "input": { "tool": "read" },
    "output": {
      "args": {
        "filePath": "/repo/src/main.ts"
      }
    }
  },
  "tool_before_glob": {
    "input": { "tool": "glob" },
    "output": {
      "args": {
        "path": "/repo",
        "pattern": "**/*.ts"
      }
    }
  },
  "tool_before_no_args": {
    "input": { "tool": "list" },
    "output": {
      "args": {}
    }
  },
  "tool_before_long_command": {
    "input": { "tool": "bash" },
    "output": {
      "args": {
        "command": "rg --multiline 'pattern' /a/very/long/path/that/keeps/going/and/going/with/lots/of/text/and/keeps/going/and/going/and/going/and/going/and/going/and/going/and/going/and/going/until/it/exceeds/the/200/character/truncation/limit/we/apply/in/the/extractor/helper/function"
      }
    }
  },
  "tool_after_bash": {
    "input": { "tool": "bash" }
  }
}
